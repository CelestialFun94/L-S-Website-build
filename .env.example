# Public Supabase configuration. The publishable key is safe for browser use
# only when every exposed table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values used by Vercel Functions. Never expose these in browser code.
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=https://loveandsunshinenash.com/api/microsoft-calendar?action=callback
# 32 random bytes, base64 encoded. Generate and configure in the hosting secret manager.
INTEGRATION_ENCRYPTION_KEY=
PUBLIC_SITE_URL=http://localhost:3000
